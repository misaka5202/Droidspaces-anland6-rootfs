#!/bin/sh
# anland-apps —— enumerate and launch container applications for the Android
# side (the anland app page and its pinned shortcuts).
#
# Why this exists: anland 6.x has no desktop environment, so nothing provides
# "list the installed applications / start one". The session is anland-session
# plus one Android window per toplevel; the APK only knows about windows that
# already exist. This tool bridges that gap on the container side, where the
# .desktop files and the session environment actually live.
#
# Commands:
#   anland-apps list            one record per application, tab-separated:
#                               id<TAB>name<TAB>terminal(0|1)<TAB>nodisplay(0|1)
#   anland-apps run <id>        launch that application in the session
#   anland-apps exec <id>       same, but exec (used by pinned shortcuts)
#
# Rules:
#   * ids are derived from the .desktop basename and restricted to
#     [a-z0-9-]; anything else is skipped, so a hostile .desktop name cannot
#     smuggle arguments into the launcher.
#   * Only Type=Application entries are listed, NoDisplay=true/Hidden=true are
#     flagged rather than dropped (the APK decides), and Exec field codes
#     (%f %u %F %U %i %c %k) are stripped — we never pass them.
#   * Launches source ~/.anlandx-env first: without XDG_RUNTIME_DIR and
#     WAYLAND_DISPLAY the client cannot reach the daemon and nothing appears.

set -u

APPDIR="${ANLAND_APPS_DIR:-/usr/share/applications}"
ENVF="${HOME:-/root}/.anlandx-env"

die() { printf '%s\n' "$*" >&2; exit 1; }

# Read one key from a .desktop file, first occurrence wins, honouring the
# [Desktop Entry] group only.
desktop_get() {
    awk -v key="$2" '
        /^\[/ { ingroup = ($0 == "[Desktop Entry]"); next }
        ingroup && index($0, key "=") == 1 { sub("^" key "=", ""); print; exit }
    ' "$1" 2>/dev/null
}

id_for() {
    base=$(basename "$1" .desktop | tr 'A-Z' 'a-z')
    case "$base" in
        *[!a-z0-9-]*) return 1 ;;
        '') return 1 ;;
    esac
    printf '%s' "$base"
}

cmd_list() {
    [ -d "$APPDIR" ] || return 0
    for f in "$APPDIR"/*.desktop; do
        [ -f "$f" ] || continue
        id=$(id_for "$f") || continue
        type=$(desktop_get "$f" Type)
        [ "$type" = "Application" ] || continue
        name=$(desktop_get "$f" Name)
        [ -n "$name" ] || name=$id
        exec_line=$(desktop_get "$f" Exec)
        [ -n "$exec_line" ] || continue
        terminal=0
        [ "$(desktop_get "$f" Terminal)" = "true" ] && terminal=1
        nodisplay=0
        [ "$(desktop_get "$f" NoDisplay)" = "true" ] && nodisplay=1
        [ "$(desktop_get "$f" Hidden)" = "true" ] && nodisplay=1
        # strip Exec field codes; keep the program and its literal arguments
        set -- $(printf '%s' "$exec_line" | sed 's/%[fFuUdDnNickvm]//g')
        [ $# -ge 1 ] || continue
        printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$terminal" "$nodisplay" "$*"
    done
}

resolve_exec() {
    want="$1"
    [ -d "$APPDIR" ] || die "no application directory"
    for f in "$APPDIR"/*.desktop; do
        [ -f "$f" ] || continue
        id=$(id_for "$f") || continue
        [ "$id" = "$want" ] || continue
        [ "$(desktop_get "$f" Type)" = "Application" ] || die "not an application: $want"
        exec_line=$(desktop_get "$f" Exec)
        [ -n "$exec_line" ] || die "no Exec line: $want"
        terminal=$(desktop_get "$f" Terminal)
        # field codes: drop the ones we never honour, expand nothing else
        exec_line=$(printf '%s' "$exec_line" | sed 's/%[fFuUdDnNickvm]//g')
        printf '%s\n%s\n' "$terminal" "$exec_line"
        return 0
    done
    die "unknown application: $want"
}

cmd_run() {
    [ $# -ge 1 ] || die "usage: anland-apps run <id>"
    resolved=$(resolve_exec "$1") || exit 1
    terminal=$(printf '%s' "$resolved" | sed -n '1p')
    exec_line=$(printf '%s' "$resolved" | sed -n '2p')

    # The session publishes its environment here; a launch without it cannot
    # reach the daemon.
    if [ -r "$ENVF" ]; then
        while IFS= read -r line; do
            case "$line" in
                ''|'#'*) ;;
                *=*) export "$line" ;;
            esac
        done < "$ENVF"
    elif [ -z "${WAYLAND_DISPLAY:-}" ]; then
        die "no session environment (start the anland session first)"
    fi

    # Terminal applications need a terminal emulator; foot is the Wayland-native
    # one the image ships.
    if [ "$terminal" = "true" ]; then
        exec setsid foot -e sh -c "$exec_line"
    fi
    exec setsid sh -c "$exec_line"
}

case "${1:-}" in
    list) cmd_list ;;
    run) shift; cmd_run "$@" ;;
    *) die "usage: anland-apps list | anland-apps run <id>" ;;
esac
