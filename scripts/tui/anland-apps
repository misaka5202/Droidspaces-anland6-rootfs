#!/bin/sh
# anland-apps — launch one application inside the container by .desktop id.
#
#   anland-apps run <id>
#
# The daemon calls this to start container software on behalf of a pinned
# home-screen shortcut. It exists as a separate step because the daemon must
# never accept an executable path from the caller: the host activity that
# forwards a shortcut intent is exported, so anything it accepts is reachable
# by every app on the device. Here the only input is an id matching
# [a-z0-9-], and the argv comes from the container's own .desktop file — an
# arbitrary-command channel would require writing a .desktop inside the
# container first, which already means root inside it.
#
# Listing is deliberately not implemented: anland-shell parses the .desktop
# dump itself (with localisation and precedence) and owns the catalogue UI.

set -u

APPDIR="${ANLAND_APPS_DIR:-/usr/share/applications}"
LOCALDIR="${ANLAND_APPS_LOCAL_DIR:-/usr/local/share/applications}"

# Resolve the session env file from the account database, never from $HOME:
# droidspaces injects the HOST environment into container processes, so $HOME
# can arrive as an Android/Windows path that does not exist in here.
user_home() {
    home=""
    if command -v getent >/dev/null 2>&1; then
        home=$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f6)
    fi
    if [ -z "$home" ]; then
        home=$(awk -F: -v u="$(id -un)" '$1 == u { print $6; exit }' /etc/passwd 2>/dev/null)
    fi
    printf '%s' "${home:-/root}"
}
ENVF="$(user_home)/.anlandx-env"
# X11 display number, written by the session as a separate one-liner (the env
# file above carries only the wayland/meson variables). Applications that fall
# back to X11 — Qt's wayland plugin does not initialise on every GPU path —
# need DISPLAY, and without it they abort with "could not connect to display".
XDISPLAY_FILE="$(user_home)/.anlandx"

# Diagnostics go to a file as well as stderr: the daemon runs this helper with
# its stderr discarded, so a failure there is otherwise invisible on the device
# (a tap that does nothing, with no trace anywhere).
SELF_LOG="${ANLAND_APPS_SELF_LOG:-/run/anland/anland-apps.log}"
say() {
    printf 'anland-apps: %s\n' "$*" >&2
    printf '%s %s\n' "$(date +%H:%M:%S)" "$*" >>"$SELF_LOG" 2>/dev/null || true
}
die() { say "$*"; exit 1; }

# One key from a .desktop file, first occurrence, [Desktop Entry] group only.
desktop_get() {
    awk -v key="$2" '
        /^\[/ { ingroup = ($0 == "[Desktop Entry]"); next }
        ingroup && index($0, key "=") == 1 { sub("^" key "=", ""); print; exit }
    ' "$1" 2>/dev/null
}

[ "${1:-}" = "run" ] || die "usage: anland-apps run <id>"
[ $# -ge 2 ] || die "usage: anland-apps run <id>"

id=$2
# Real .desktop basenames look like org.gnome.clocks / com.github.johnfactotum.
# Foliate: letters, digits, dots, dash and underscore. '.' is allowed because
# ids use it as a namespace separator, so reject traversal explicitly — no
# slash can appear at all, and a leading dot would name a hidden/relative path.
case "$id" in
    *[!A-Za-z0-9._-]*|'') die "invalid app id: $id" ;;
    .*|*..*)              die "invalid app id: $id" ;;
esac

# Later directories win, matching the .desktop spec (user/local over system).
desktop=""
for d in "$APPDIR" "$LOCALDIR"; do
    [ -f "$d/$id.desktop" ] && desktop="$d/$id.desktop"
done
[ -n "$desktop" ] || die "unknown app id: $id"
[ "$(desktop_get "$desktop" Type)" = "Application" ] || die "not an application: $id"

exec_line=$(desktop_get "$desktop" Exec)
[ -n "$exec_line" ] || die "no Exec line: $id"
# Field codes (%f %u %F %U ...) are never substituted: a launcher tab has no
# file to hand over, and leaving them in would pass the literal token.
exec_line=$(printf '%s' "$exec_line" | sed 's/%[fFuUdDnNickvm]//g')

# The session publishes its environment here; without XDG_RUNTIME_DIR and
# WAYLAND_DISPLAY the client cannot reach the daemon and nothing appears.
#
# A shortcut is also the first thing run after a cold container start, when no
# session exists yet, so bring it up here: this runs as the desktop user inside
# the container, which is exactly the context systemd --user needs.
# Ask systemd rather than trusting the env file: the session removes it on a
# clean exit but not when it is killed, and a stale file would make a dead
# session look alive — the client then fails to connect and the tap does
# nothing. `systemctl --user` needs XDG_RUNTIME_DIR, which a plain `su -` login
# shell does not set (the call then fails before logging anything).
if command -v systemctl >/dev/null 2>&1; then
    [ -n "${XDG_RUNTIME_DIR:-}" ] || XDG_RUNTIME_DIR="/run/user/$(id -u)"
    export XDG_RUNTIME_DIR
    if [ "$(systemctl --user is-active anland-session 2>/dev/null)" != "active" ]; then
        systemctl --user start anland-session >/dev/null 2>&1 || true
        i=0
        while [ ! -r "$ENVF" ] && [ $i -lt 25 ]; do
            sleep 1
            i=$((i + 1))
        done
    fi
fi

# systemctl --user resolves the user bus through XDG_RUNTIME_DIR, which a plain
# `su -` login shell does not set. Without it every probe fails and the session
# is "unusable" on every launch, restarting it each time and killing the client
# that was just started (the app then dies with "The X11 connection broke").
# Set it once, up front, for every check below.
[ -n "${XDG_RUNTIME_DIR:-}" ] || XDG_RUNTIME_DIR="/run/user/$(id -u)"
export XDG_RUNTIME_DIR

# The daemon runs with HOME=/ (it is an Android init-style service), and the
# child inherits it. systemctl --user resolves the user manager partly through
# HOME, so a wrong value makes every probe fail the same way. The real home comes
# from the account database.
case "${HOME:-}" in
    "$(user_home)"|"") HOME="$(user_home)"; export HOME ;;
esac

# The session must actually be running: it owns Xwayland, the wayland link and
# the environment. Probing the daemon's socket is not enough — that socket stays
# alive on its own, so a dead session looks healthy and every launch then gets a
# stale (or missing) DISPLAY and produces no window.
need_session=0
if command -v systemctl >/dev/null 2>&1; then
    sess_state=$(systemctl --user is-active anland-session 2>/dev/null)
    case "$sess_state" in
        active) ;;
        # already coming up: restarting it here would kill the launch
        activating|deactivating) need_session=2 ;;
        *) need_session=1 ;;
    esac
    if [ "$need_session" = 2 ]; then
        i=0
        while [ "$(systemctl --user is-active anland-session 2>/dev/null)" != "active" ] && [ $i -lt 30 ]; do
            sleep 1
            i=$((i + 1))
        done
        need_session=0
    fi
    # Liveness of the compositor connection is deliberately NOT probed here:
    # `exec 9<>socket` is not a valid test for a unix socket in POSIX sh (the
    # shell tries to open it read-write, which sockets reject), so it reports
    # every healthy socket as dead. A client that cannot connect reports that
    # itself, with a specific error, in the log this helper keeps.
    if [ "$need_session" = 1 ]; then
        # `start`, never `restart`: restarting stops the session first, and that
        # kills Xwayland under a client this helper is about to launch — the app
        # then dies with "The X11 connection broke". Starting an already-running
        # unit is a no-op, so this is safe either way.
        say 'starting the session (it was not running)'
        systemctl --user start anland-session >/dev/null 2>&1 || true
        i=0
        while [ ! -r "$ENVF" ] && [ $i -lt 30 ]; do
            sleep 1
            i=$((i + 1))
        done
    fi
fi

# The environment file is written by the session once Xwayland and mini-wm are
# up, and removed again by its cleanup on every restart, so it can be missing
# for a moment even though the session was started. Wait for it instead of
# failing the tap: the caller has already brought the session up.
i=0
while [ ! -r "$ENVF" ] && [ $i -lt 30 ]; do
    sleep 1
    i=$((i + 1))
done
if [ -r "$ENVF" ]; then
    while IFS= read -r line; do
        case "$line" in
            ''|'#'*) ;;
            *=*) export "$line" ;;
        esac
    done < "$ENVF"
fi
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    die "no session environment (is the anland session running?)"
fi

# X11 fallback: the session publishes the display number in ~/.anlandx, not in
# the env file. Export it so toolkits that give up on wayland (Qt's plugin does
# on this GPU path) can still reach Xwayland.
# X11 display: the session publishes the authoritative value as a systemd user
# environment variable, and only mirrors it into ~/.anlandx. The mirror goes
# stale whenever an earlier session wrote it, and connecting to a dead Xwayland
# fails with "The X11 connection broke". Prefer the user manager's value and use
# the file only as a fallback.
if [ -z "${DISPLAY:-}" ] && command -v systemctl >/dev/null 2>&1; then
    mgr_display=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^DISPLAY=//p')
    case "$mgr_display" in
        :[0-9]*) DISPLAY="$mgr_display"; export DISPLAY ;;
    esac
fi
# The systemd user environment can be empty (a restarted session republishes
# it, and until it does every consumer sees nothing), so fall back to the
# sockets Xwayland actually left behind: the highest numbered one is the live
# display.
if [ -z "${DISPLAY:-}" ]; then
    for x in /tmp/.X11-unix/X*; do
        [ -S "$x" ] || continue
        n="${x##*/X}"
        case "$n" in ''|*[!0-9]*) continue ;; esac
        DISPLAY=":$n"
    done
    [ -n "${DISPLAY:-}" ] && export DISPLAY
fi
if [ -z "${DISPLAY:-}" ] && [ -r "$XDISPLAY_FILE" ]; then
    xdisp=$(head -1 "$XDISPLAY_FILE" 2>/dev/null | tr -d '[:space:]')
    case "$xdisp" in
        # the file already holds the screen number with its colon (":1")
        :[0-9]*) DISPLAY="$xdisp"; export DISPLAY ;;
        [0-9]*)  DISPLAY=":$xdisp"; export DISPLAY ;;
    esac
fi

# Hand the process to the systemd user manager rather than detaching it with
# setsid: `droidspaces run` tears down the process tree it created, so a
# backgrounded client is killed the moment this helper returns — the shortcut
# then looks like it did nothing while the app had already been started.
# A transient --user unit belongs to the user manager instead, and inherits the
# session environment through --setenv below (systemd-run does not forward the
# caller's environment). `--collect` keeps a failed unit's status readable.
# Unit names must be unique per launch. A transient unit stays registered after
# its process exits (and after a crash), so reusing the id as the unit name
# makes every second launch fail with "Unit ... was already loaded", which looks
# exactly like a dead shortcut. Clear a stale unit of the same name first, then
# give this launch its own name so a still-running instance is not disturbed.
UNIT="anland-app-$(printf '%s' "$id" | tr -c 'A-Za-z0-9-' '-')"
APP_LOG="${XDG_RUNTIME_DIR:-/tmp}/anland-app.log"
command -v systemd-run >/dev/null 2>&1 || die "systemd-run is missing; cannot launch"

# Clear units left by earlier launches. This must not decide whether to start:
# units use unique names now, so any match here is a leftover, and treating one
# as "already running" skips the launch entirely (a tap that silently does
# nothing). Process liveness is checked below instead.
systemctl --user reset-failed "$UNIT" >/dev/null 2>&1 || true
systemctl --user stop "$UNIT" >/dev/null 2>&1 || true

# Unique per launch so a lingering unit cannot block the next tap.
LAUNCH_UNIT="$UNIT-$(date +%s)-$$"

# shellcheck disable=SC2086  # exec_line is an argument list by design
systemd-run --user --quiet --unit "$LAUNCH_UNIT" \
    --property=StandardOutput="append:$APP_LOG" \
    --property=StandardError="append:$APP_LOG" \
    --setenv="HOME=$(user_home)" \
    --setenv="XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}" \
    --setenv="WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}" \
    --setenv="DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-}" \
    --setenv="PULSE_SERVER=${PULSE_SERVER:-}" \
    --setenv="PATH=${PATH:-/usr/local/bin:/usr/bin:/bin}" \
    --setenv="DISPLAY=${DISPLAY:-}" \
    --setenv="QT_QPA_PLATFORM=wayland" \
    --setenv="GDK_BACKEND=wayland" \
    --setenv="SDL_VIDEODRIVER=wayland" \
    --setenv="CLUTTER_BACKEND=wayland" \
    --setenv="ECORE_EVAS_ENGINE=wayland_shm" \
    --setenv="ELM_ENGINE=wayland_shm" \
    --setenv="MOZ_ENABLE_WAYLAND=1" \
    /bin/sh -c "exec $exec_line" || die "could not start $id"

# Report a unit that died at once (bad library, no display, crashed on startup)
# instead of leaving 'the icon did nothing' as the only symptom.
sleep 2
if ! systemctl --user is-active --quiet "$LAUNCH_UNIT" 2>/dev/null; then
    say "$exec_line exited immediately; see $APP_LOG"
    systemctl --user status "$LAUNCH_UNIT" --no-pager -n 15 2>&1 >&2 || true
    exit 1
fi
say "launched $exec_line (unit $LAUNCH_UNIT)"
exit 0
