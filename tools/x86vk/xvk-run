#!/bin/sh
# xvk-run — run an x86_64 Vulkan client against this device's GPU.
#
# Verified on Adreno 735 (SM7675) inside a droidspaces container:
#
#   $ xvk-run --summary                 # vulkaninfo, enumerates the GPU
#   $ vkcube --wsi wayland --c 120 ...  # renders; ~83 fps at 640x360
#
# The whole trick is to let box64 wrap the host's own libvulkan instead of
# emulating an x86_64 one:
#
#   [BOX64] Using native(wrapped) libvulkan.so.1
#
# The aarch64 Turnip that ships in the image is already kgsl-capable, so no
# x86_64 driver is needed at all. Cross-building one is a dead end; see
# NOTES.md in this directory for why (GBM needs the full GL state tracker, which
# a Vulkan-only build cannot have).
#
# Two prerequisites that are easy to miss and produce confusing symptoms:
#
#   * Run as the user that owns the display sockets. anland starts Xwayland and
#     the Wayland socket as the session user (uid 1000), so a root-owned process
#     gets 'Authorization required' from X or an unusable Wayland connection.
#   * The screen must be awake. With the device asleep no window is composited,
#     so no wl_surface.frame callback ever arrives and every client blocks in
#     poll until it times out — which looks exactly like a driver hang.
#
# Usage: xvk-run [vulkaninfo-args...]
set -u

ROOT=${X86ROOT:-/opt/x86root}
SESSION_USER=${XVK_USER:-Gold}
WORK=${XVK_WORK:-/tmp/xvk}
LOG="$WORK/vulkaninfo.log"

mkdir -p "$WORK"

die() { echo "xvk-run: $*" >&2; exit 1; }

[ -x "$ROOT/usr/bin/vulkaninfo" ] || die "$ROOT/usr/bin/vulkaninfo missing"

# The host loader and Turnip must be present: they are what actually runs.
[ -e /usr/lib/aarch64-linux-gnu/libvulkan.so.1 ] \
    || die "host libvulkan missing; this path wraps the host loader"

# A stale .hidden library from an older approach would silently change which
# driver loads. Put them back rather than debug a phantom.
for f in /usr/lib/aarch64-linux-gnu/*.hidden; do
    [ -e "$f" ] && mv "$f" "${f%.hidden}" 2>/dev/null
done

# Deliberately unset: pinning this at an x86_64 ICD is what made box64 emulate a
# driver instead of wrapping the host one, and that path cannot present.
unset VK_ICD_FILENAMES VK_DRIVER_FILES 2>/dev/null || true

if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d /run/user/1000 ]; then
    XDG_RUNTIME_DIR=/run/user/1000
    export XDG_RUNTIME_DIR
fi
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -S /run/anland/wayland-0 ]; then
    WAYLAND_DISPLAY=wayland-anland
    export WAYLAND_DISPLAY
fi

# Wake the panel: a sleeping device composites nothing, and the client then waits
# forever for frame callbacks.
if command -v dumpsys >/dev/null 2>&1; then
    if dumpsys power 2>/dev/null | grep -q 'mWakefulness=Asleep'; then
        echo "xvk-run: screen asleep — waking it (otherwise nothing is composited)" >&2
        input keyevent KEYCODE_WAKEUP >/dev/null 2>&1
        sleep 1
        wm dismiss-keyguard >/dev/null 2>&1
        sleep 1
    fi
fi

ENVV="XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR WAYLAND_DISPLAY=$WAYLAND_DISPLAY \
BOX64_LOG=${BOX64_LOG:-0} BOX64_LD_LIBRARY_PATH=$ROOT/usr/lib:$ROOT/usr/lib/x86_64-linux-gnu"

# Drop privileges when asked to, so the process owns the display sockets.
if [ "$(id -u)" = "0" ] && [ -n "$SESSION_USER" ]; then
    runuser -u "$SESSION_USER" -- env $ENVV box64 "$ROOT/usr/bin/vulkaninfo" "$@" \
        > "$LOG" 2>&1
else
    env $ENVV box64 "$ROOT/usr/bin/vulkaninfo" "$@" > "$LOG" 2>&1
fi
rc=$?

# box64 is chatty about the native libraries it declines to wrap; that noise is
# expected here, not a failure.
grep -vE '^\[.?.?.?BOX64' "$LOG" | grep -vE '^[[:space:]]*$'
exit $rc
