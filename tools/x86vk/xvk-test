#!/bin/sh
# xvk-test — answer one question on the device: can an x86_64 Vulkan client
# drive kgsl through Box64?
#
# The image ships no aarch64 graphics stack on purpose (see the Dockerfile), so
# the probes check that precondition first and then run the real one. Written
# for /bin/sh; no bash-isms.
#
# Exit status is the number of failed probes, so a caller can gate on it.
set -u

ROOT=${X86ROOT:-/opt/x86root}
LOG=${XVK_LOG:-/tmp/xvk}

fail=0
say() { printf '\n=== %s\n' "$*"; }
ok()  { printf 'RESULT: PASS (%s)\n' "$*"; }
bad() { printf 'RESULT: FAIL (%s)\n' "$*"; fail=$((fail + 1)); }

say "environment"
echo "arch          : $(uname -m)"
echo "kernel        : $(uname -r)"
echo "x86root       : $ROOT"
echo "box64         : $(command -v box64 || echo MISSING)"
for n in /dev/kgsl-3d0 /dev/dri/renderD128 /dev/dri/card0; do
    if [ -e "$n" ]; then echo "gpu node      : $n present"; else echo "gpu node      : $n absent"; fi
done
echo "x86_64 turnip : $(ls "$ROOT"/usr/lib/libvulkan_freedreno.so 2>/dev/null || echo MISSING)"
# Arch installs the loader flat in usr/lib; a Debian/Ubuntu amd64 package puts it
# under usr/lib/x86_64-linux-gnu. Report whichever this tree carries.
echo "x86_64 loader : $(ls "$ROOT"/usr/lib/libvulkan.so.1 "$ROOT"/usr/lib/x86_64-linux-gnu/libvulkan.so.1 2>/dev/null | head -1 || echo MISSING)"
echo "x86_64 icd    : $(ls "$ROOT"/usr/share/vulkan/icd.d/freedreno_icd.json 2>/dev/null || echo MISSING)"

# ---------------------------------------------------------------------------
# Precondition, not a baseline: Box64 prefers to wrap a native library over the
# emulated one, and the distro's aarch64 libxcb/libwayland are older than what
# Turnip 26.x links against. A device run failed on exactly that:
#   Global Symbol xcb_dri3_import_syncobj_checked not found
#   Global Symbol wl_display_create_queue_with_name not found
# Box64 0.3.8 has no per-library "do not wrap" switch, so this image ships no
# native graphics libraries at all. If one appears here, the probe is measuring
# the wrong thing.
say "probe 1/3: no aarch64 graphics stack (precondition)"
native=""
for lib in libvulkan.so.1 libvulkan_freedreno.so libxcb.so.1 \
           libwayland-client.so.0 libX11.so.6; do
    hit=$(find /usr/lib /lib -maxdepth 3 -name "$lib" 2>/dev/null | head -1)
    [ -n "$hit" ] && native="$native $hit"
done
if [ -z "$native" ]; then
    ok "no native graphics libraries box64 could wrap"
else
    bad "native graphics libraries present, box64 will wrap them:$native"
fi

# ---------------------------------------------------------------------------
say "probe 2/3: box64 runs an x86_64 binary"
if [ ! -x "$ROOT/usr/bin/true" ]; then
    bad "$ROOT/usr/bin/true missing — x86_64 tree not unpacked"
elif BOX64_LOG=0 BOX64_LD_LIBRARY_PATH="$ROOT/usr/lib:$ROOT/usr/lib/x86_64-linux-gnu" \
        box64 "$ROOT/usr/bin/true" >/dev/null 2>&1; then
    ok "x86_64 binary ran under box64"
else
    bad "x86_64 binary did not run under box64"
fi

# ---------------------------------------------------------------------------
say "probe 3/3: x86_64 Vulkan against kgsl (the question)"
if [ ! -x "$ROOT/usr/bin/vulkaninfo" ]; then
    bad "$ROOT/usr/bin/vulkaninfo missing — install vulkan-tools into x86root"
else
    mkdir -p "$LOG"
    # The packaged json names the library relatively; give the x86_64 loader an
    # absolute path so it cannot resolve the ICD against host (aarch64) dirs.
    if [ -f "$ROOT/usr/share/vulkan/icd.d/freedreno_icd.json" ]; then
        sed "s|\"library_path\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"library_path\": \"$ROOT/usr/lib/libvulkan_freedreno.so\"|" \
            "$ROOT/usr/share/vulkan/icd.d/freedreno_icd.json" > "$LOG/freedreno_icd.json"
    else
        bad "no freedreno_icd.json in the x86_64 tree"
    fi

    [ -f "$LOG/freedreno_icd.json" ] && {
        BOX64_LOG=1 \
        BOX64_LD_LIBRARY_PATH="$ROOT/usr/lib:$ROOT/usr/lib/x86_64-linux-gnu" \
        VK_ICD_FILENAMES="$LOG/freedreno_icd.json" \
        VK_DRIVER_FILES="$LOG/freedreno_icd.json" \
        timeout 180 box64 "$ROOT/usr/bin/vulkaninfo" --summary > "$LOG/vulkaninfo.log" 2>&1
        rc=$?

        echo "--- which libvulkan box64 chose ---"
        grep -i 'libvulkan' "$LOG/vulkaninfo.log" | head -4
        echo "--- vulkaninfo output ---"
        grep -viE '^\[BOX64\]' "$LOG/vulkaninfo.log" | tail -20

        if grep -qi 'Turnip' "$LOG/vulkaninfo.log"; then
            ok "x86_64 Turnip created a device against the GPU — DXVK is viable here"
        elif grep -qi 'dlopen\|Global Symbol\|Unhandled signal' "$LOG/vulkaninfo.log"; then
            bad "x86_64 Turnip loaded but failed on missing symbols (see $LOG/vulkaninfo.log)"
        else
            bad "x86_64 Turnip did not create a device (rc=$rc, see $LOG/vulkaninfo.log)"
        fi
    }
fi

say "summary"
echo "failed probes: $fail"
[ "$fail" -eq 0 ] && echo "ALL PROBES PASSED"
exit "$fail"
